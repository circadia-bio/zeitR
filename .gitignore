# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
*.DS_Store

# notebooks
notebooks/
.DS_Store
src/*.o
src/*.so
src/*.dll
/doc/
/Meta/
ID0003.txt

# Participant data -- never commit, regardless of where it lands.
# Scoped to dev/ specifically -- intentional package fixtures belong in
# inst/extdata/ and should be added deliberately, not swept up here.
# Raw device exports:
dev/ID*.txt
dev/input*.txt
# Any subdirectory of raw device exports (e.g. dev/new_participant_data/,
# used for real files placed locally for a diagnostic comparison):
dev/new_participant_data/
# Python-derived per-participant fixtures (real timestamps/durations):
dev/*python_nights.csv
dev/*python_epochs.csv
dev/*python_output.csv
dev/*python_estimates.csv
# Comparison/reference outputs derived from real participant recordings:
dev/*reference*.csv
dev/*_reference_*.csv

# dev/ defaults to untracked: diagnostic scripts written against real
# participant data have repeatedly ended up with real timestamps/dates
# embedded in comments or output examples, not just in the data files
# above -- safer to require an explicit `git add -f` for anything in
# dev/ that's actually meant to be committed (e.g. dev/parity_vallim.py,
# already tracked from before this rule existed) than to keep auditing
# every new script by hand.
dev/*
